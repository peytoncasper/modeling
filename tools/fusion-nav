#!/usr/bin/env python3
"""CLI for Fusion 360 navigation / indexing system.

Wraps the FusionMCPBridge HTTP API at localhost:8080.
Provides access to the STATE + PATCH + LOCAL_GRAPH + Frames + Entity
Resolver + ACTION subsystems for LLM spatial awareness.

Examples — State:
    fusion-nav state                       # full STATE snapshot
    fusion-nav state --sparse              # omit empty/null fields
    fusion-nav nav-string                  # one-line compact state

Examples — Patches:
    fusion-nav patches                     # patches since t=0
    fusion-nav patches --since 42          # patches since tick 42
    fusion-nav drain                       # return + clear all patches

Examples — Local graph:
    fusion-nav graph                       # auto-detect focus
    fusion-nav graph --kind sketch --id Sketch1
    fusion-nav graph --kind body --id Body1 --depth 2
    fusion-nav graph --kind feature --id Extrude1
    fusion-nav graph --kind face --id Body1_face_0

Examples — Actions:
    fusion-nav actions                     # list available actions
    fusion-nav do sketch.create --args '{"plane":"xy","name":"Sketch1"}'
    fusion-nav do feature.extrude --ctx '{"sketch":"Sketch1"}' --args '{"distance":20}'
    fusion-nav do sketch.add_rectangle --ctx '{"sketch":"S1"}' --args '{"corner1":[0,0],"corner2":[50,30]}'

Examples — Frames:
    fusion-nav frames                      # list all frames
    fusion-nav frames --type body          # filter by type
    fusion-nav frame WorldFrame            # get specific frame
    fusion-nav frame WorldFrame --children # include child details
    fusion-nav create-frame MyFrame --type body --origin 0,0,0
    fusion-nav delete-frame MyFrame
    fusion-nav body-frame Body1            # auto-frame from body bbox
    fusion-nav interface-frame --parent Body1_Frame --name Joint1 --origin 25,15,0 --normal 0,0,1
    fusion-nav nearby --origin 50,40,10 --radius 100
    fusion-nav transform --point 10,20,30 --from WorldFrame --to Body1_Frame

Examples — Entity resolver:
    fusion-nav entities                    # list cached entity refs
    fusion-nav entities --type body        # filter by type
    fusion-nav resolve myEntityToken       # look up a cached ref
"""

import argparse
import json
import sys
import urllib.request
import urllib.error

BRIDGE = "http://localhost:8080"


def call(endpoint, body=None):
    data = json.dumps(body or {}).encode()
    req = urllib.request.Request(
        f"{BRIDGE}{endpoint}", data=data,
        headers={"Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.URLError as e:
        return {"error": True, "message": f"Cannot connect to Fusion bridge: {e}"}
    except Exception as e:
        return {"error": True, "message": str(e)}


def out(data):
    print(json.dumps(data, indent=2))


def p3(s):
    parts = [float(x.strip()) for x in s.split(",")]
    if len(parts) != 3:
        sys.exit(f"Error: expected x,y,z but got '{s}'")
    return parts


# ── Commands ──────────────────────────────────────────────────

def cmd_state(args):
    body = {}
    if args.sparse:
        body["sparse"] = True
    out(call("/get_state", body))


def cmd_nav_string(args):
    out(call("/get_state_compact"))


def cmd_patches(args):
    out(call("/get_patches_since", {"since_t": args.since}))


def cmd_drain(args):
    out(call("/drain_patches"))


def cmd_graph(args):
    body = {
        "focus_kind": args.kind,
        "depth": args.depth,
    }
    if args.id:
        body["focus_id"] = args.id
    if args.component:
        body["component"] = args.component
    out(call("/get_local_graph", body))


def cmd_actions(args):
    out(call("/list_actions"))


def cmd_do(args):
    action = {"op": args.op}
    if args.ctx:
        action["ctx"] = json.loads(args.ctx)
    if args.args:
        action["args"] = json.loads(args.args)
    out(call("/apply_action", {"action": action}))


def cmd_frames(args):
    body = {}
    if args.type:
        body["filter"] = {"type": args.type}
    out(call("/list_frames", body))


def cmd_frame(args):
    body = {"name": args.name}
    if args.children:
        body["include_children"] = True
    if args.mates:
        body["include_mates"] = True
    out(call("/get_frame", body))


def cmd_create_frame(args):
    body = {
        "name": args.name,
        "type": args.type,
        "origin": p3(args.origin),
        "orientation": {"x": 0, "y": 0, "z": 0},
    }
    if args.parent:
        body["parent"] = args.parent
    if args.orientation:
        ox, oy, oz = p3(args.orientation)
        body["orientation"] = {"x": ox, "y": oy, "z": oz}
    out(call("/create_frame", body))


def cmd_delete_frame(args):
    out(call("/delete_frame", {"name": args.name}))


def cmd_body_frame(args):
    body = {"body_name": args.body}
    if args.component:
        body["component"] = args.component
    out(call("/create_body_frame", body))


def cmd_interface_frame(args):
    body = {
        "parent_frame": args.parent,
        "name": args.name,
        "origin": p3(args.origin),
        "normal": p3(args.normal),
    }
    if args.mates_with:
        body["mates_with"] = args.mates_with
    out(call("/create_interface_frame", body))


def cmd_nearby(args):
    body = {
        "origin": p3(args.origin),
        "radius": args.radius,
    }
    out(call("/get_nearby_frames", body))


def cmd_transform(args):
    body = {
        "point": p3(args.point),
        "from_frame": getattr(args, "from"),
        "to_frame": args.to,
    }
    out(call("/transform_point", body))


def cmd_entities(args):
    body = {}
    if args.type:
        body["type"] = args.type
    out(call("/list_entities", body))


def cmd_resolve(args):
    out(call("/resolve_entity", {"id": args.id}))


# ── Argument parser ──────────────────────────────────────────

def build_parser():
    p = argparse.ArgumentParser(
        prog="fusion-nav",
        description="Fusion 360 navigation / indexing CLI")
    sub = p.add_subparsers(dest="command", required=True)

    # state
    sp = sub.add_parser("state", help="Full STATE snapshot")
    sp.add_argument("--sparse", action="store_true", help="Omit empty/null fields")

    # nav-string
    sub.add_parser("nav-string", help="One-line compact state")

    # patches
    sp = sub.add_parser("patches", help="Get state patches since tick t")
    sp.add_argument("--since", type=int, default=0, help="Tick to fetch from (default 0)")

    # drain
    sub.add_parser("drain", help="Return + clear all queued patches")

    # graph
    sp = sub.add_parser("graph", help="LOCAL_GRAPH around a focus entity")
    sp.add_argument("--kind", default="auto",
                     choices=["auto", "sketch", "body", "face", "edge", "feature", "none"],
                     help="Focus entity type (default: auto-detect)")
    sp.add_argument("--id", help="Focus entity name/id")
    sp.add_argument("--depth", type=int, default=1, help="Neighborhood depth (default 1)")
    sp.add_argument("--component", help="Scope to a specific component")

    # actions
    sub.add_parser("actions", help="List available ACTION ops")

    # do
    sp = sub.add_parser("do", help="Execute a structured ACTION")
    sp.add_argument("op", help="Action op (e.g. sketch.create, feature.extrude)")
    sp.add_argument("--ctx", help="JSON context (e.g. '{\"sketch\":\"Sketch1\"}')")
    sp.add_argument("--args", help="JSON arguments")

    # frames
    sp = sub.add_parser("frames", help="List all frames")
    sp.add_argument("--type", help="Filter by frame type (world, plane, body, interface)")

    # frame
    sp = sub.add_parser("frame", help="Get a specific frame")
    sp.add_argument("name", help="Frame name")
    sp.add_argument("--children", action="store_true", help="Include child frame details")
    sp.add_argument("--mates", action="store_true", help="Include mating frames")

    # create-frame
    sp = sub.add_parser("create-frame", help="Create a new frame")
    sp.add_argument("name", help="Frame name")
    sp.add_argument("--type", required=True, help="Frame type (body, plane, interface, custom)")
    sp.add_argument("--origin", required=True, help="Origin x,y,z in mm")
    sp.add_argument("--parent", help="Parent frame name")
    sp.add_argument("--orientation", help="Orientation x,y,z in degrees")

    # delete-frame
    sp = sub.add_parser("delete-frame", help="Delete a frame and its children")
    sp.add_argument("name", help="Frame name")

    # body-frame
    sp = sub.add_parser("body-frame", help="Auto-create frame from body bounding box")
    sp.add_argument("body", help="Body name")
    sp.add_argument("--component", help="Component name scope")

    # interface-frame
    sp = sub.add_parser("interface-frame", help="Create an interface/joint frame")
    sp.add_argument("--parent", required=True, help="Parent frame name")
    sp.add_argument("--name", required=True, help="Interface frame name")
    sp.add_argument("--origin", required=True, help="Origin x,y,z in mm")
    sp.add_argument("--normal", required=True, help="Normal vector x,y,z")
    sp.add_argument("--mates-with", help="Name of mating interface")

    # nearby
    sp = sub.add_parser("nearby", help="Find frames near a point")
    sp.add_argument("--origin", required=True, help="Search center x,y,z in mm")
    sp.add_argument("--radius", type=float, default=50.0, help="Search radius in mm (default 50)")

    # transform
    sp = sub.add_parser("transform", help="Transform a point between frames")
    sp.add_argument("--point", required=True, help="Point x,y,z in mm")
    sp.add_argument("--from", required=True, help="Source frame name", dest="from")
    sp.add_argument("--to", required=True, help="Target frame name")

    # entities
    sp = sub.add_parser("entities", help="List cached entity refs")
    sp.add_argument("--type", help="Filter by entity type (body, face, edge, sketch, feature)")

    # resolve
    sp = sub.add_parser("resolve", help="Look up a cached entity ref")
    sp.add_argument("id", help="Entity id/token")

    return p


DISPATCH = {
    "state": cmd_state,
    "nav-string": cmd_nav_string,
    "patches": cmd_patches,
    "drain": cmd_drain,
    "graph": cmd_graph,
    "actions": cmd_actions,
    "do": cmd_do,
    "frames": cmd_frames,
    "frame": cmd_frame,
    "create-frame": cmd_create_frame,
    "delete-frame": cmd_delete_frame,
    "body-frame": cmd_body_frame,
    "interface-frame": cmd_interface_frame,
    "nearby": cmd_nearby,
    "transform": cmd_transform,
    "entities": cmd_entities,
    "resolve": cmd_resolve,
}


def main():
    parser = build_parser()
    args = parser.parse_args()
    fn = DISPATCH.get(args.command)
    if fn:
        fn(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
